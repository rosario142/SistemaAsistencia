# EditorConfig: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Markdown usa dos espacios finales para forzar salto de línea
trim_trailing_whitespace = false

[*.sh]
# Los scripts bash deben tener finales de línea LF (incluso en Windows)
end_of_line = lf

[*.{yml,yaml}]
indent_size = 2

[Makefile]
indent_style = tab
