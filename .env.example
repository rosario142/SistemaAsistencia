# =============================================================================
# SICAE — Plantilla de variables de entorno
# Copia este archivo a `.env` en la raíz y a `apps/api/.env` (NestJS las lee
# desde su directorio). NUNCA subas el `.env` real al repositorio.
# =============================================================================

# Entorno de ejecución: development | test | production
NODE_ENV=development

# --- Base de datos (PostgreSQL 16) -------------------------------------------
# En Docker Compose el host es el servicio "postgres", no "localhost".
DATABASE_URL="postgresql://sicae:sicae_secret@localhost:5432/sicae?schema=public"

# --- Autenticación (JWT) -----------------------------------------------------
# Obligatorio en producción: mínimo 32 caracteres aleatorios.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="cambia-este-secreto-en-produccion-minimo-32-chars"
JWT_EXPIRES_IN="8h"

# --- API ----------------------------------------------------------------------
# Puerto del servidor NestJS.
PORT=3000
# Origen permitido para CORS (la SPA en desarrollo).
WEB_ORIGIN="http://localhost:5173"

# --- Correo saliente (reset de contraseñas, notificaciones de justificación) --
SMTP_HOST="localhost"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="SICAE <no-reply@sicae.edu>"

# --- Subida de archivos (adjuntos de justificaciones) -------------------------
# Directorio local; en Docker se monta como volumen (ver docker-compose.yml).
UPLOAD_DIR="./uploads"
