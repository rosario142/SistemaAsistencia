# ---- SICAE API ----
NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173

# PostgreSQL (igual que en infrastructure/docker/docker-compose.yml)
DATABASE_URL="postgresql://sicae:sicae_secret@localhost:5432/sicae?schema=public"

# Seguridad
JWT_SECRET=cambia-esta-clave-en-produccion
JWT_EXPIRES_IN=8h

# Subida de archivos (justificaciones)
UPLOAD_DIR=./uploads

# Correo (opcional en desarrollo; si no hay SMTP, los mails se registran en consola)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SICAE <no-reply@sicae.edu>"