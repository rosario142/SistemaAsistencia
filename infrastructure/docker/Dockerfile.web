# =============================================================================
# SICAE — SPA React (multi-stage build)
# Etapa "build":   compila el frontend con Vite usando pnpm.
# Etapa "runtime": nginx:alpine sirviendo los estáticos con fallback SPA.
# Build (desde la raíz del repo):
#   docker build -f infrastructure/docker/Dockerfile.web \
#     --build-arg VITE_API_URL=https://api.tudominio.edu/api/v1 -t sicae-web .
# =============================================================================
FROM node:22-alpine AS build

WORKDIR /repo

# URL base de la API que el SPA usará en tiempo de build (baking en el bundle).
# Por defecto sirve el mismo origen vía el proxy /api/ de nginx.
ARG VITE_API_URL=/api/v1
ENV VITE_API_URL=${VITE_API_URL}

RUN corepack enable

# Manifiestos primero para cachear capas (igual que en Dockerfile.api).
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile || pnpm install --no-frozen-lockfile

COPY . .
RUN pnpm --filter @sicae/web build

# --- Etapa runtime: nginx con la SPA compilada --------------------------------
FROM nginx:1.27-alpine AS runtime

# Conf del contenedor web (estáticos + fallback SPA). La copia se hace en el
# build para que la imagen sea autocontenida.
COPY infrastructure/nginx/web.conf /etc/nginx/conf.d/default.conf
COPY --from=build /repo/apps/web/dist /usr/share/nginx/html

EXPOSE 80

# Comprobación de salud con wget (busybox) incluido en Alpine.
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1/ >/dev/null 2>&1 || exit 1
